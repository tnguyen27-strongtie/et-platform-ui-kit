{
  "name": "@platform/ui",
  "version": "0.4.0",
  "private": true,
  "description": "Shared React component kit (MUI 9 + Tailwind 4) for platform calculator apps",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@12.6.0",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme.css": "./dist/theme/theme.css",
    "./tokens": {
      "types": "./dist/tokens/tokens.d.ts",
      "import": "./dist/tokens/tokens.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "tokens": "node scripts/build-tokens.ts",
    "build": "pnpm tokens && tsc -b && vite build -c vite.lib.config.ts && tsc -p tsconfig.lib.json && mkdir -p dist/theme && cp src/theme/*.css dist/theme/",
    "build:showcase": "tsc -b && vite build --outDir dist-showcase",
    "typecheck": "tsc -b && tsc -p tsconfig.node.json",
    "lint": "eslint .",
    "test": "node --test \"tests/unit/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "preview": "vite preview --outDir dist-showcase",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.0"
  },
  "dependencies": {
    "@tanstack/react-table": "^9.2.4",
    "clsx": "^2.1.1",
    "react-resizable-panels": "^4.13.2",
    "react-toastify": "^11.1.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@emotion/react": "~11.14.0",
    "@emotion/styled": "~11.14.1",
    "@eslint/js": "^10.0.1",
    "@mui/icons-material": "~9.4.0",
    "@mui/material": "~9.4.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "react": "~19.3.0",
    "react-dom": "~19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0"
  }
}
